# PayPilot environment — copy to .env and fill in (never commit real secrets)

# Backend: "mock" (default, demo) or "sandbox" (real PayPal sandbox REST APIs)
PAYPAL_MODE=mock

# Required only for PAYPAL_MODE=sandbox — from a free PayPal Developer sandbox app
# (https://developer.paypal.com/ -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Display name shown as the invoicer in sandbox mode
PAYPAL_MERCHANT_NAME=PayPilot Merchant

# Optional LLM "brain" for NL parsing (any OpenAI-compatible chat endpoint).
# Leave unset to use the built-in deterministic rule parser (zero cost).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini

# Web UI port
PORT=8080
